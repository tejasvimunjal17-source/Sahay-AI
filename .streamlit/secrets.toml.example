# Copy to .streamlit/secrets.toml for local development, or paste into
# Streamlit Community Cloud's secrets manager for deployment.
# NONE of these are required to run Phase 1 — the app runs fully without
# any of them configured.

APP_NAME = "Sahay AI"
COMPANION_NAME = "Sahay"
APP_ENV = "development"

# --- Phase 2 (Supabase Auth + user data) ---
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""

# --- Phase 2 (Google OAuth) ---
GOOGLE_OAUTH_CLIENT_ID = ""
GOOGLE_OAUTH_REDIRECT_URL = ""

# --- Phase 3 (AI engine) ---
OPENROUTER_API_KEY = ""
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
OPENROUTER_MODEL = "openai/gpt-4o-mini"

# --- Phase 7 (Admin) — service-role key, NEVER expose to the browser ---
# Only backend/supabase_admin_client.py may ever read this.
SUPABASE_SERVICE_ROLE_KEY = ""
