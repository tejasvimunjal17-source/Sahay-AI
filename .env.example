# Same variables as .streamlit/secrets.toml.example, for local non-Streamlit
# tooling / running outside Streamlit Cloud. Copy to .env and fill in as
# each phase requires it — none are required for Phase 1.

APP_NAME=Sahay AI
COMPANION_NAME=Sahay
APP_ENV=development

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
